<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="purchase_approval_level_view_tree" model="ir.ui.view">
        <field name="name">purchase.approval.level.tree</field>
        <field name="model">purchase.approval.level</field>
        <field name="arch" type="xml">
            <tree string="Approval Levels">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="min_amount"/>
                <field name="user_ids" widget="many2many_avatar_user"/>
                <field name="group_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="currency_id" column_invisible="True"/>
            </tree>
        </field>
    </record>

    <record id="purchase_approval_level_view_form" model="ir.ui.view">
        <field name="name">purchase.approval.level.form</field>
        <field name="model">purchase.approval.level</field>
        <field name="arch" type="xml">
            <form string="Approval Level">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name" placeholder="e.g. Director"/>
                            <field name="min_amount"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="user_ids" widget="many2many_avatar_user"/>
                            <field name="group_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="purchase_approval_level_action" model="ir.actions.act_window">
        <field name="name">Approval Levels</field>
        <field name="res_model">purchase.approval.level</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define your purchase approval levels</p>
            <p>For example: Team leader from 0, Director from 5,000, CEO from 50,000.
               Enable the feature in Purchase settings.</p>
        </field>
    </record>

    <menuitem id="menu_purchase_approval_level"
              name="Approval Levels"
              parent="purchase.menu_purchase_config"
              action="purchase_approval_level_action"
              groups="purchase.group_purchase_manager"
              sequence="30"/>

</odoo>
