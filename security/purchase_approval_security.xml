<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="purchase_approval_level_company_rule" model="ir.rule">
        <field name="name">Purchase approval level: multi-company</field>
        <field name="model_id" ref="model_purchase_approval_level"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="purchase_order_approval_company_rule" model="ir.rule">
        <field name="name">Purchase approval step: multi-company</field>
        <field name="model_id" ref="model_purchase_order_approval"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
